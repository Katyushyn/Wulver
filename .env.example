# Copy this file to .env and choose one of the two profiles below.
# Never commit the real .env file.

# -----------------------------------------------------------------------------
# Local development (HTTP)
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SERVE_MEDIA_LOCALLY=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False
AI_ASSISTANT_TRUST_X_FORWARDED_FOR=False
TRUST_X_FORWARDED_FOR=False
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http
CSP_ENABLED=True
CSP_REPORT_ONLY=False

# -----------------------------------------------------------------------------
# Production example (HTTPS)
# Uncomment/replace these values when deploying.
# Generate SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# -----------------------------------------------------------------------------
# DEBUG=False
# SECRET_KEY=replace-with-a-unique-random-secret
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SERVE_MEDIA_LOCALLY=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# TRUST_X_FORWARDED_PROTO=True
# AI_ASSISTANT_TRUST_X_FORWARDED_FOR=True
# TRUST_X_FORWARDED_FOR=True
# ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
# CSP_ENABLED=True
# CSP_REPORT_ONLY=False

# Optional full override. Keep this on one line. Test custom themes in
# report-only mode before enforcing a stricter policy.
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests

# Set TRUST_X_FORWARDED_PROTO=True only behind a trusted HTTPS reverse proxy
# Set AI_ASSISTANT_TRUST_X_FORWARDED_FOR=True only when that proxy overwrites X-Forwarded-For
# Set TRUST_X_FORWARDED_FOR=True under the same condition for public CMS forms.
# that sets X-Forwarded-Proto correctly (for example, Nginx or a hosting proxy).

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
ARTICLE_API_TOKEN=
GITHUB_TOKEN=
